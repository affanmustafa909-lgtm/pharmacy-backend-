generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  CUSTOMER
  RIDER
}

enum DeskRole {
  OWNER
  STORE_MANAGER
  PHARMACIST
  ORDER_STAFF
}

enum InviteStatus {
  pending
  accepted
  revoked
  expired
}

enum StoreStatus {
  draft
  active
  paused
  archived
}

enum AmountMode {
  FIXED
  PERCENT
}

enum ChargeKind {
  DELIVERY
  SERVICE
  BFP
}

enum PercentBase {
  PRODUCT_SUBTOTAL
  DELIVERY
  SERVICE
  PRODUCT_AND_DELIVERY
  SUBTOTAL_BEFORE_BFP
}

enum OrderStatus {
  placed
  preparing
  ready_for_pickup
  collected
  out_for_delivery
  delivered
  cancelled
}

enum RiderApprovalStatus {
  pending
  approved
  rejected
}

enum PaymentStatus {
  unpaid
  paid
  refunded
  partially_refunded
}

enum PrescriptionStatus {
  pending
  needs_clearer_photo
  approved
  dispensed
  rejected
}

enum StockMovementReason {
  restock
  order_fulfillment
  cancellation_release
  damage
  expiry
  manual_adjustment
  import
  opening_balance
  purchase_receive
  transfer_out
  transfer_in
}

enum PurchaseStatus {
  draft
  received
  cancelled
}

enum TransferStatus {
  in_transit
  received
}

model User {
  id                   String                 @id @default(cuid())
  email                String                 @unique
  passwordHash         String
  name                 String
  phone                String                 @default("")
  city                 String                 @default("")
  dateOfBirth          String                 @default("")
  gender               String                 @default("")
  allergies            String                 @default("")
  profilePhoto         String?
  role                 Role
  deskRole             DeskRole               @default(ORDER_STAFF)
  storeId              String?
  store                Store?                 @relation("StaffStore", fields: [storeId], references: [id])
  canChangePrice       Boolean                @default(false)
  canRefund            Boolean                @default(false)
  passwordResetToken   String?
  passwordResetExpires DateTime?
  createdAt            DateTime               @default(now())
  orders               Order[]
  threads              MessageThread[]
  addresses            CustomerAddress[]
  favorites            CustomerFavorite[]
  checkoutGroups       CheckoutGroup[]
  stockAlerts          StockAlert[]
  notifications        CustomerNotification[]
  assignments          StoreAssignment[]
  invitesSent          StaffInvite[]          @relation("InviteSender")
  audits               AuditLog[]
  stockMovements       StockMovement[]
  reviewedRx           Prescription[]         @relation("RxReviewer")
  managedStores        Store[]                @relation("StoreManager")
  pharmacistStores     Store[]                @relation("StorePharmacistUser")
  riderProfile         Rider?
  riderNotifications   RiderNotification[]
}

model CheckoutGroup {
  id             String   @id @default(cuid())
  customerId     String
  customer       User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  idempotencyKey String   @unique
  deliveryType   String
  paymentLabel   String
  recipientName  String   @default("")
  recipientPhone String   @default("")
  addressLine    String   @default("")
  addressJson    Json?
  createdAt      DateTime @default(now())
  orders         Order[]

  @@index([customerId, createdAt])
}

model StoreAssignment {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId        String
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  deskRole       DeskRole
  canChangePrice Boolean  @default(false)
  canRefund      Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@unique([userId, storeId])
  @@index([storeId])
  @@index([userId])
}

model StaffInvite {
  id             String       @id @default(cuid())
  email          String
  storeId        String
  store          Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  deskRole       DeskRole
  canChangePrice Boolean      @default(false)
  canRefund      Boolean      @default(false)
  status         InviteStatus @default(pending)
  token          String       @unique
  invitedById    String
  invitedBy      User         @relation("InviteSender", fields: [invitedById], references: [id])
  acceptedUserId String?
  createdAt      DateTime     @default(now())
  acceptedAt     DateTime?

  @@index([email, status])
  @@index([storeId])
}

model CustomerAddress {
  id                    String  @id @default(cuid())
  customerId            String
  customer              User    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label                 String
  line                  String
  latitude              Float?
  longitude             Float?
  recipientName         String  @default("")
  houseNo               String  @default("")
  street                String  @default("")
  subCity               String  @default("")
  city                  String  @default("")
  state                 String  @default("")
  country               String  @default("")
  postalCode            String  @default("")
  landmark              String  @default("")
  phone                 String  @default("")
  deliveryInstructions  String  @default("")
  isDefault             Boolean @default(false)

  @@index([customerId])
}

model CustomerFavorite {
  id         String   @id @default(cuid())
  customerId String
  customer   User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
  @@index([customerId])
  @@index([productId])
}

model PromoCode {
  id        String   @id @default(cuid())
  code      String   @unique
  label     String
  discount  Decimal  @db.Decimal(12, 2)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Store {
  id               String            @id @default(cuid())
  code             String            @unique
  name             String
  address               String
  city                  String            @default("")
  country               String            @default("")
  maxDeliveryDistanceKm Float?
  openUntil             String
  weeklyHours      Json              @default("{}")
  closedDays       Json              @default("[]")
  holidayHours     Json              @default("[]")
  mapLat           Float?
  mapLng           Float?
  rating           Float             @default(0)
  status           StoreStatus       @default(active)
  isOpen           Boolean           @default(true)
  acceptingOrders  Boolean           @default(true)
  phone            String            @default("")
  pharmacist       String            @default("")
  managerUserId    String?
  managerUser      User?             @relation("StoreManager", fields: [managerUserId], references: [id])
  pharmacistUserId String?
  pharmacistUser   User?             @relation("StorePharmacistUser", fields: [pharmacistUserId], references: [id])
  lowStockThreshold Int              @default(12)
  createdAt        DateTime          @default(now())
  staff            User[]            @relation("StaffStore")
  products         Product[]
  services         Service[]
  chargeRules      ChargeRule[]
  riders           Rider[]
  orders           Order[]
  prescriptions    Prescription[]
  stockAlerts      StockAlert[]
  assignments      StoreAssignment[]
  invites          StaffInvite[]
  batches          InventoryBatch[]
  stockMovements   StockMovement[]
  deliveryOptions  StoreDeliveryOption[]
  audits           AuditLog[]
}

model StoreDeliveryOption {
  id          String  @id @default(cuid())
  storeId     String
  store       Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  type        String
  label       String
  available   Boolean @default(true)
  fee         Decimal @db.Decimal(12, 2)
  etaMinutes  Int     @default(45)
  deliveryArea String @default("")

  @@unique([storeId, type])
  @@index([storeId])
}

model Rider {
  id                   String               @id @default(cuid())
  storeId              String?
  store                Store?               @relation(fields: [storeId], references: [id], onDelete: SetNull)
  userId               String?              @unique
  user                 User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  name                 String
  phone                String               @default("")
  vehicle              String               @default("Bike")
  notes                String               @default("")
  active               Boolean              @default(false)
  isPrimary            Boolean              @default(false)
  approvalStatus       RiderApprovalStatus  @default(pending)
  idDocumentUrl        String               @default("")
  licenseDocumentUrl   String               @default("")
  vehicleDocumentUrl   String               @default("")
  rejectedReason       String               @default("")
  reviewedAt           DateTime?
  createdAt            DateTime             @default(now())
  orders               Order[]
  notifications        RiderNotification[]

  @@index([storeId, active])
  @@index([storeId, isPrimary])
  @@index([approvalStatus, createdAt])
}

model RiderNotification {
  id        String   @id @default(cuid())
  riderId   String
  rider     Rider    @relation(fields: [riderId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      String
  title     String
  body      String
  data      Json     @default("{}")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([riderId, createdAt])
  @@index([riderId, read])
  @@index([userId, createdAt])
}

model Product {
  id                String           @id @default(cuid())
  storeId           String
  store             Store            @relation(fields: [storeId], references: [id])
  sku               String
  name              String
  brand             String           @default("hera.")
  genericName       String           @default("")
  strength          String           @default("")
  category          String           @default("Medicines")
  unitLabel         String           @default("1 unit")
  description       String           @default("")
  imageUrl          String           @default("")
  price             Decimal          @db.Decimal(12, 2)
  stock             Int              @default(0)
  batch             String           @default("")
  expiry            String           @default("")
  held              Boolean          @default(false)
  onlineSale        Boolean          @default(true)
  published         Boolean          @default(true)
  rxRequired        Boolean          @default(false)
  lowStockAlerts    Boolean          @default(true)
  lowStockThreshold Int?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  orderItems        OrderItem[]
  stockAlerts       StockAlert[]
  batches           InventoryBatch[]
  stockMovements    StockMovement[]
  favorites         CustomerFavorite[]

  @@unique([storeId, sku])
  @@index([storeId])
  @@index([name])
  @@index([genericName])
  @@index([sku])
}

model InventoryBatch {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  batchNumber String   @default("")
  quantity    Int
  expiry      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([productId])
  @@index([storeId, expiry])
}

model StockMovement {
  id          String              @id @default(cuid())
  productId   String
  product     Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  storeId     String
  store       Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  quantity    Int
  reason      StockMovementReason
  note        String              @default("")
  orderNumber String              @default("")
  userId      String?
  user        User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  batchNumber String              @default("")
  unitCost    Decimal?            @db.Decimal(12, 2)
  requestId   String?             @unique
  createdAt   DateTime            @default(now())

  @@index([productId, createdAt])
  @@index([storeId, createdAt])
  @@index([orderNumber, productId, reason])
}

model Service {
  id          String       @id @default(cuid())
  storeId     String
  store       Store        @relation(fields: [storeId], references: [id])
  name        String
  description String       @default("")
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  chargeRules ChargeRule[]

  @@index([storeId])
}

model ChargeRule {
  id           String       @id @default(cuid())
  storeId      String
  store        Store        @relation(fields: [storeId], references: [id])
  serviceId    String?
  service      Service?     @relation(fields: [serviceId], references: [id])
  kind         ChargeKind
  label        String
  mode         AmountMode
  amount       Decimal      @db.Decimal(12, 2)
  percentBase  PercentBase?
  deliveryType  String?
  minDistanceKm Float?
  maxDistanceKm Float?
  perKmRate     Decimal?     @db.Decimal(12, 2)
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())

  @@index([storeId, kind])
}

model Order {
  id                 String         @id @default(cuid())
  number             String         @unique
  customerId         String
  customer           User           @relation(fields: [customerId], references: [id])
  storeId            String
  store              Store          @relation(fields: [storeId], references: [id])
  checkoutGroupId    String?
  checkoutGroup      CheckoutGroup? @relation(fields: [checkoutGroupId], references: [id], onDelete: SetNull)
  riderId            String?
  rider              Rider?         @relation(fields: [riderId], references: [id], onDelete: SetNull)
  status             OrderStatus    @default(placed)
  paymentStatus      PaymentStatus  @default(paid)
  channel            String         @default("Mobile app")
  deliveryType       String
  paymentLabel       String
  addressLine        String         @default("")
  recipientName      String         @default("")
  recipientPhone     String         @default("")
  addressJson        Json?
  deliveryDistanceKm Float?
  prescriptionNumber String         @default("")
  cancelReason       String         @default("")
  refundReason       String         @default("")
  refundAmount       Decimal        @default(0) @db.Decimal(12, 2)
  productSubtotal    Decimal        @db.Decimal(12, 2)
  deliveryCharge     Decimal        @db.Decimal(12, 2)
  serviceCharge      Decimal        @db.Decimal(12, 2)
  bfpCharge          Decimal        @db.Decimal(12, 2)
  discount           Decimal        @default(0) @db.Decimal(12, 2)
  total              Decimal        @db.Decimal(12, 2)
  createdAt          DateTime       @default(now())
  items              OrderItem[]
  charges            OrderCharge[]
  activities         OrderActivity[]
  messages           OrderMessage[]

  @@index([storeId, createdAt])
  @@index([customerId])
  @@index([checkoutGroupId])
  @@index([riderId, status])
  @@index([status])
  @@index([paymentStatus])
}

model OrderMessage {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  senderRole String
  senderName String   @default("")
  body       String
  createdAt  DateTime @default(now())

  @@index([orderId, createdAt])
}

model OrderActivity {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  label     String
  detail    String   @default("")
  actor     String   @default("")
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  sku       String
  unitPrice Decimal  @db.Decimal(12, 2)
  quantity  Int
  lineTotal Decimal  @db.Decimal(12, 2)
}

model OrderCharge {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind        ChargeKind
  label       String
  mode        AmountMode
  rate        Decimal      @db.Decimal(12, 2)
  percentBase PercentBase?
  baseAmount  Decimal      @db.Decimal(12, 2)
  amount      Decimal      @db.Decimal(12, 2)
}

model Prescription {
  id              String             @id @default(cuid())
  number          String             @unique
  customerId      String
  customerName    String
  storeId         String
  store           Store              @relation(fields: [storeId], references: [id])
  /// medicine_packaging | prescription
  uploadType      String             @default("prescription")
  medicineName    String             @default("")
  prescriber      String             @default("")
  quantity        String             @default("")
  imageUrl        String             @default("")
  imageHash       String             @default("")
  scannedText     String             @default("")
  imageReadable   Boolean            @default(true)
  detectedDetails Json               @default("{}")
  linkedProductId String?
  verifiedItems   Json               @default("[]")
  customerNote    String             @default("")
  status          PrescriptionStatus @default(pending)
  notes           String             @default("")
  reviewerId      String?
  reviewer        User?              @relation("RxReviewer", fields: [reviewerId], references: [id])
  reviewedAt      DateTime?
  orderNumber     String             @default("")
  submittedAt     DateTime           @default(now())
  updatedAt       DateTime           @default(now()) @updatedAt

  @@index([customerId, submittedAt])
  @@index([storeId, status])
}

model StockAlert {
  id          String   @id @default(cuid())
  customerId  String
  customer    User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  sku         String
  productName String   @default("")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([customerId, storeId, sku])
  @@index([storeId, sku, active])
}

model CustomerNotification {
  id         String   @id @default(cuid())
  customerId String
  customer   User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type       String
  title      String
  body       String
  data       Json     @default("{}")
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([customerId, createdAt])
  @@index([customerId, read])
}

model Reminder {
  id           String    @id @default(cuid())
  customerId   String?
  customerName String
  medicine     String
  time         String
  frequency    String
  enabled      Boolean   @default(true)
  adherence    Int       @default(0)
  productId    String?
  orderNumber  String?
  snoozedUntil DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  storeId   String?
  store     Store?   @relation(fields: [storeId], references: [id], onDelete: SetNull)
  action    String
  detail    String   @default("")
  meta      Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([storeId, createdAt])
  @@index([actorId, createdAt])
}

model Campaign {
  id     String  @id @default(cuid())
  title  String
  detail String
  ends   String
  active Boolean @default(false)
}

model CareEvent {
  id        String   @id @default(cuid())
  title     String
  dateLabel String
  points    Int
  createdAt DateTime @default(now())
}

model MessageThread {
  id         String    @id @default(cuid())
  customerId String
  customer   User      @relation(fields: [customerId], references: [id])
  online     Boolean   @default(false)
  unread     Int       @default(0)
  messages   Message[]
}

model Message {
  id        String        @id @default(cuid())
  threadId  String
  thread    MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  from      String
  text      String
  at        String
  createdAt DateTime      @default(now())
}

model Notice {
  id        String   @id @default(cuid())
  title     String
  body      String
  at        String
  read      Boolean  @default(false)
  page      String
  createdAt DateTime @default(now())
}

model Payout {
  id        String   @id @default(cuid())
  amount    Decimal  @db.Decimal(12, 2)
  note      String
  createdAt DateTime @default(now())
}

model Setting {
  id                 String  @id @default("default")
  storeName          String  @default("Hera Pharmacy")
  alertEmail         Boolean @default(true)
  lowStockThreshold  Int     @default(12)
  autoApproveRefills Boolean @default(false)
  showOutOfStock     Boolean @default(true)
  carePoints         Int     @default(9570)
  careTier           String  @default("Gold")
  memberSince        String  @default("March 2024")
  pointsToNext       Int     @default(1430)
  nextTier           String  @default("Platinum")
  rewardValue        Int     @default(125)
  mobileConfig       Json    @default("{}")
}
model Supplier {
  id        String            @id @default(cuid())
  storeId   String
  name      String
  contact   String            @default("")
  address   String            @default("")
  active    Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @default(now()) @updatedAt
  invoices  PurchaseInvoice[]

  @@index([storeId, name])
}

model PurchaseInvoice {
  id          String            @id @default(cuid())
  number      String
  supplierId  String
  storeId     String
  status      PurchaseStatus    @default(draft)
  note        String            @default("")
  createdById String?
  receivedAt  DateTime?
  createdAt   DateTime          @default(now())
  supplier    Supplier          @relation(fields: [supplierId], references: [id])
  lines       PurchaseLine[]
  payments    SupplierPayment[]

  @@unique([storeId, number])
  @@index([supplierId])
  @@index([storeId, status])
}

model PurchaseLine {
  id          String          @id @default(cuid())
  invoiceId   String
  productId   String
  batchNumber String
  expiry      String
  quantity    Int
  unitCost    Decimal         @db.Decimal(12, 2)
  invoice     PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model SupplierPayment {
  id         String          @id @default(cuid())
  invoiceId  String
  amount     Decimal         @db.Decimal(12, 2)
  receiptRef String
  note       String          @default("")
  userId     String?
  paidAt     DateTime        @default(now())
  invoice    PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, receiptRef])
  @@index([invoiceId])
}

model StockTransfer {
  id             String         @id @default(cuid())
  fromStoreId    String
  toStoreId      String
  sku            String
  batchNumber    String
  expiry         String
  quantity       Int
  status         TransferStatus @default(in_transit)
  requestId      String?        @unique
  dispatchedById String?
  receivedById   String?
  dispatchedAt   DateTime       @default(now())
  receivedAt     DateTime?

  @@index([fromStoreId, status])
  @@index([toStoreId, status])
}
